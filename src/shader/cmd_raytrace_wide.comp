#version 460
#extension GL_GOOGLE_include_directive: enable

#include "bvh_wide_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

#define STACK_CAPACITY 128

layout(push_constant) uniform PC {
    float g_originX, g_originY, g_originZ;
    float g_rightX, g_rightY, g_rightZ;
    float g_upX, g_upY, g_upZ;
    float g_forwardX, g_forwardY, g_forwardZ;
    float g_tanHalfFovY;
    float g_aspect;
    uint g_width;
    uint g_height;
    uint g_shadeMode;
    float g_tMin;
    float g_tMax;
    float g_lightDirX;
    float g_lightDirY;
    float g_lightDirZ;
    uint g_groundStartIndex;
    uint g_outputSwapRedBlue;
    float g_lightPosX;
    float g_lightPosY;
    float g_lightPosZ;
    uint g_lightType;
};

// primitive index >= g_groundStartIndex 이면 바닥(ground), 미만이면 구체 재질
const vec3 kSphereAlbedo = vec3(0.82, 0.32, 0.22);
const vec3 kGroundAlbedo = vec3(0.55, 0.56, 0.60);
const float kAmbient = 0.18;

layout(std430, set = 0, binding = 0) readonly buffer Nodes {
    WideNode g_nodes[];
};
layout(std430, set = 0, binding = 1) readonly buffer Leaves {
    LeafRange g_leaves[];
};
layout(std430, set = 0, binding = 2) readonly buffer MortonCodes {
    MortonCode g_mortonCodes[];
};
layout(std430, set = 0, binding = 3) readonly buffer Primitives {
    Primitive g_primitives[];
};
// 삼각형당 9 floats: v0.xyz, v1.xyz, v2.xyz (vkSpatial::TrianglePrim과 동일 레이아웃)
layout(std430, set = 0, binding = 4) readonly buffer TriVerts {
    float g_triVerts[];
};
// packUnorm4x8 결과(R8G8B8A8 순서)를 픽셀당 하나씩 기록
layout(std430, set = 0, binding = 5) writeonly buffer Output {
    uint g_pixels[];
};

uint unpackByte(uint word, uint slot) {
    return (word >> ((slot & 3u) * 8u)) & 0xFFu;
}

void decodeChild(in WideNode node, uint slot, out vec3 mn, out vec3 mx) {
    uint word = slot / 4u;
    vec3 qMin = vec3(
        unpackByte(node.qBounds[0u + word], slot),
        unpackByte(node.qBounds[2u + word], slot),
        unpackByte(node.qBounds[4u + word], slot));
    vec3 qMax = vec3(
        unpackByte(node.qBounds[6u + word], slot),
        unpackByte(node.qBounds[8u + word], slot),
        unpackByte(node.qBounds[10u + word], slot));
    vec3 origin = vec3(node.originX, node.originY, node.originZ);
    vec3 scale = vec3(node.scaleX, node.scaleY, node.scaleZ);
    mn = origin + scale * qMin;
    mx = origin + scale * qMax;
}

bool rayAABB(vec3 ro, vec3 invRd, vec3 mn, vec3 mx, float tMaxIn, out float tNear) {
    vec3 t0 = (mn - ro) * invRd;
    vec3 t1 = (mx - ro) * invRd;
    vec3 ts = min(t0, t1);
    vec3 tb = max(t0, t1);
    tNear = max(max(ts.x, ts.y), max(ts.z, 0.0));
    float tFar = min(min(tb.x, tb.y), min(tb.z, tMaxIn));
    return tNear <= tFar;
}

bool rayTriangle(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2,
                  float tMaxIn, out float tHit, out vec3 normal) {
    const float EPS = 1e-7;
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 pvec = cross(rd, e2);
    float det = dot(e1, pvec);
    if (abs(det) < EPS)
        return false;

    float invDet = 1.0 / det;
    vec3 tvec = ro - v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0)
        return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(rd, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0)
        return false;

    float t = dot(e2, qvec) * invDet;
    if (t < g_tMin || t > tMaxIn)
        return false;

    tHit = t;
    normal = normalize(cross(e1, e2));
    return true;
}

// 그림자 판정 전용 any-hit 순회: 가장 가까운 교차점을 찾을 필요 없이
// 첫 교차를 발견하는 즉시 반환한다 (섀도우 레이는 픽셀당 한 번씩 추가로 순회).
bool traceShadow(vec3 ro, vec3 rd, float tMaxIn) {
    vec3 invRd = 1.0 / rd;
    uint stack[STACK_CAPACITY];
    uint top = 0u;
    stack[top++] = 0u;

    while (top > 0u) {
        WideNode node = g_nodes[stack[--top]];

        for (uint slot = 0u; slot < node.childCount; ++slot) {
            vec3 childMin;
            vec3 childMax;
            decodeChild(node, slot, childMin, childMax);

            float tNear;
            if (!rayAABB(ro, invRd, childMin, childMax, tMaxIn, tNear))
                continue;

            if ((node.leafMask & (1u << slot)) != 0u) {
                LeafRange leaf = g_leaves[node.child[slot]];
                for (uint i = 0u; i < leaf.primitiveCount; ++i) {
                    uint sortedIndex = leaf.firstPrimitive + i;
                    uint primIndex = g_mortonCodes[sortedIndex].index;
                    uint base = primIndex * 9u;

                    vec3 v0 = vec3(g_triVerts[base + 0u], g_triVerts[base + 1u], g_triVerts[base + 2u]);
                    vec3 v1 = vec3(g_triVerts[base + 3u], g_triVerts[base + 4u], g_triVerts[base + 5u]);
                    vec3 v2 = vec3(g_triVerts[base + 6u], g_triVerts[base + 7u], g_triVerts[base + 8u]);

                    float t;
                    vec3 n;
                    if (rayTriangle(ro, rd, v0, v1, v2, tMaxIn, t, n))
                        return true;
                }
            } else if (top < STACK_CAPACITY) {
                stack[top++] = node.child[slot];
            }
        }
    }
    return false;
}

vec3 skyColor(vec3 dir) {
    float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    return mix(vec3(0.10, 0.11, 0.15), vec3(0.35, 0.55, 0.85), t);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= g_width || pixel.y >= g_height)
        return;

    vec3 origin = vec3(g_originX, g_originY, g_originZ);
    vec3 right = vec3(g_rightX, g_rightY, g_rightZ);
    vec3 up = vec3(g_upX, g_upY, g_upZ);
    vec3 forward = vec3(g_forwardX, g_forwardY, g_forwardZ);

    vec2 ndc = (vec2(pixel) + 0.5) / vec2(g_width, g_height) * 2.0 - 1.0;
    // pixel.y == 0 이 화면 맨 위 행이므로, ndc.y 부호를 뒤집어 위쪽이 +up이 되게 한다.
    vec3 rd = normalize(
        forward +
        right * (ndc.x * g_tanHalfFovY * g_aspect) -
        up * (ndc.y * g_tanHalfFovY));
    vec3 invRd = 1.0 / rd;

    uint stack[STACK_CAPACITY];
    uint top = 0u;
    stack[top++] = 0u;

    float closestT = g_tMax;
    vec3 closestNormal = vec3(0.0);
    uint hitPrimIndex = 0u;
    bool hit = false;

    while (top > 0u) {
        WideNode node = g_nodes[stack[--top]];

        for (uint slot = 0u; slot < node.childCount; ++slot) {
            vec3 childMin;
            vec3 childMax;
            decodeChild(node, slot, childMin, childMax);

            float tNear;
            if (!rayAABB(origin, invRd, childMin, childMax, closestT, tNear))
                continue;

            if ((node.leafMask & (1u << slot)) != 0u) {
                LeafRange leaf = g_leaves[node.child[slot]];
                for (uint i = 0u; i < leaf.primitiveCount; ++i) {
                    uint sortedIndex = leaf.firstPrimitive + i;
                    uint primIndex = g_mortonCodes[sortedIndex].index;
                    uint base = primIndex * 9u;

                    vec3 v0 = vec3(g_triVerts[base + 0u], g_triVerts[base + 1u], g_triVerts[base + 2u]);
                    vec3 v1 = vec3(g_triVerts[base + 3u], g_triVerts[base + 4u], g_triVerts[base + 5u]);
                    vec3 v2 = vec3(g_triVerts[base + 6u], g_triVerts[base + 7u], g_triVerts[base + 8u]);

                    float t;
                    vec3 n;
                    if (rayTriangle(origin, rd, v0, v1, v2, closestT, t, n)) {
                        closestT = t;
                        closestNormal = n;
                        hitPrimIndex = primIndex;
                        hit = true;
                    }
                }
            } else if (top < STACK_CAPACITY) {
                stack[top++] = node.child[slot];
            }
            // 스택이 가득 차면 해당 서브트리는 조용히 스킵(miss로 취급) —
            // 스레드당 자기 픽셀만 쓰므로 다른 스레드에 영향 없음.
        }
    }

    vec3 color;
    if (!hit) {
        color = skyColor(rd);
    } else if (g_shadeMode == 0u) {
        color = abs(closestNormal);
    } else if (g_shadeMode == 1u) {
        float shade = 1.0 - clamp(closestT / g_tMax, 0.0, 1.0);
        color = vec3(shade);
    } else {
        vec3 albedo = hitPrimIndex >= g_groundStartIndex ? kGroundAlbedo : kSphereAlbedo;
        vec3 hitPoint = origin + rd * closestT;

        // 카메라를 향하도록 노멀 방향을 정렬 (삼각형 winding에 무관하게 동작)
        vec3 n = closestNormal;
        if (dot(n, rd) > 0.0)
            n = -n;

        vec3 lightDir = normalize(vec3(g_lightDirX, g_lightDirY, g_lightDirZ));
        float shadowTMax = g_tMax;
        float attenuation = 1.0;
        if (g_lightType == 1u) {
            vec3 lightVec = vec3(g_lightPosX, g_lightPosY, g_lightPosZ) - hitPoint;
            float lightDistance = length(lightVec);
            lightDir = lightVec / max(lightDistance, 1e-4);
            shadowTMax = max(lightDistance - 0.01, 0.0);
            attenuation = 1.0 / (1.0 + 0.04 * lightDistance * lightDistance);
        }

        float diffuse = max(dot(n, lightDir), 0.0);

        float shadow = 1.0;
        if (diffuse > 0.0) {
            vec3 shadowOrigin = hitPoint + n * 0.001;
            if (traceShadow(shadowOrigin, lightDir, shadowTMax))
                shadow = 0.0;
        }

        color = albedo * (kAmbient + diffuse * shadow * attenuation * (1.0 - kAmbient));
    }

    // 대상 이미지가 VK_FORMAT_B8G8R8A8_*(예: 대부분의 macOS/MoltenVK 스왑체인)라면
    // packUnorm4x8의 R8G8B8A8 바이트 순서와 어긋나므로 여기서 미리 채널을 바꾼다.
    vec3 packedColor = g_outputSwapRedBlue != 0u ? color.bgr : color.rgb;
    g_pixels[pixel.y * g_width + pixel.x] = packUnorm4x8(vec4(packedColor, 1.0));
}
