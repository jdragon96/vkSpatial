#version 460
layout(local_size_x = 256) in;

#define TSDF_SCALE 10000.0

#include "voxel_common.glsl"   // EMPTY_KEY, MAX_PROBE, wangHash

layout(push_constant) uniform PC {
    uint  g_numPoints;
    uint  g_hashCapacity;
    float g_voxelSize;
    float g_truncation;
    float g_camX;
    float g_camY;
    float g_camZ;
    uint  g_maxDirections;
    uint  g_dirExponent;
    uint  g_viewAngleWeight;
    int   g_originX;
    int   g_originY;
    int   g_originZ;
};

struct DirEntry { uint key; int sumDW; uint sumW; int sumNx; int sumNy; int sumNz; };

layout(std430, set = 0, binding = 0) buffer HashTable { DirEntry g_hash[]; };
layout(std430, set = 0, binding = 1) readonly buffer Points  { float g_points[];  };
layout(std430, set = 0, binding = 2) readonly buffer Normals { float g_normals[]; };
layout(        set = 0, binding = 3) buffer Stat { uint g_filledCount; };

bool packDirKey(ivec3 c, uint dir, out uint key) {
    ivec3 lv = c - ivec3(g_originX, g_originY, g_originZ);
    if (lv.x < 0 || lv.x > 511 || lv.y < 0 || lv.y > 511 || lv.z < 0 || lv.z > 511) {
        key = 0u;
        return false;
    }
    key = ((uint(lv.x) & 0x1FFu) << 21u)
        | ((uint(lv.y) & 0x1FFu) << 12u)
        | ((uint(lv.z) & 0x1FFu) << 3u)
        |  (dir & 0x7u);
    return true;
}

uint findOrInsert(uint key) {
    uint slot = wangHash(key) % g_hashCapacity;
    for (uint p = 0u; p < MAX_PROBE; p++) {
        uint idx  = (slot + p) % g_hashCapacity;
        uint prev = atomicCompSwap(g_hash[idx].key, EMPTY_KEY, key);
        if (prev == EMPTY_KEY) { atomicAdd(g_filledCount, 1u); return idx; }
        if (prev == key) return idx;
    }
    return ~0u;
}

float ipow(float x, uint p) { float r = 1.0; for (uint i = 0u; i < p; i++) r *= x; return r; }

// ---------------------------------------------------------------------------------------
// Direction selection (DirectionalTSDF, Splietker & Behnke 2019)
// ---------------------------------------------------------------------------------------

const float MIN_RELATIVE_WEIGHT = 0.05; // drop directions weaker than 5% of the dominant one

uint signedAxisIndex(uint axis, float n_c) { return 2u * axis + (n_c >= 0.0 ? 0u : 1u); }

int selectDirections(vec3 n, out uint dirs[3], out float rel[3]) {
    float align[3] = float[]( abs(n.x), abs(n.y), abs(n.z) );
    uint  axis[3]  = uint[]( signedAxisIndex(0u, n.x),
                             signedAxisIndex(1u, n.y),
                             signedAxisIndex(2u, n.z) );

    // Descending insertion sort by alignment.
    for (int i = 1; i < 3; i++) {
        float a = align[i]; uint ax = axis[i];
        int j = i - 1;
        while (j >= 0 && align[j] < a) { align[j + 1] = align[j]; axis[j + 1] = axis[j]; j--; }
        align[j + 1] = a; axis[j + 1] = ax;
    }

    // The strongest axis is always kept, at relative weight 1.
    dirs[0] = axis[0];
    rel[0]  = 1.0;
    int count = 1;

    float dominantWeight = ipow(align[0], g_dirExponent);
    if (dominantWeight <= 0.0) return count;   // degenerate (zero) normal -> single layer

    // Keep further axes whose weight is a large enough fraction of the strongest.
    uint maxDirs = clamp(g_maxDirections, 1u, 3u);
    for (int i = 1; i < 3 && uint(count) < maxDirs; i++) {
        float relativeWeight = ipow(align[i], g_dirExponent) / dominantWeight;
        if (relativeWeight < MIN_RELATIVE_WEIGHT) continue;
        dirs[count] = axis[i];
        rel[count]  = relativeWeight;
        count++;
    }
    return count;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= g_numPoints) return;

    vec3 p   = vec3(g_points[gid * 3u], g_points[gid * 3u + 1u], g_points[gid * 3u + 2u]);
    vec3 nrm = vec3(g_normals[gid * 3u], g_normals[gid * 3u + 1u], g_normals[gid * 3u + 2u]);
    vec3 cam = vec3(g_camX, g_camY, g_camZ);

    vec3  diff  = p - cam;
    float depth = length(diff);
    if (depth < 1e-6) return;
    vec3 rayDir = diff / depth;

    // View-angle confidence (directional_tsdf_integrate.comp's viewFactor). rayDir is fixed
    // per point, so viewFactor is constant across the band. A back-facing/grazing observation
    // (<=0) contributes nothing -- skip early so no zero-weight entries are ever inserted.
    float viewFactor = (g_viewAngleWeight != 0u) ? max(0.0, dot(nrm, -rayDir)) : 1.0;
    if (viewFactor <= 0.0) return;

    uint  dirs[3]; float rel[3];
    int   dirCount = selectDirections(nrm, dirs, rel);

    float trunc = g_truncation;
    int   steps = int(ceil(trunc / g_voxelSize)) + 1;

    for (int t = -steps; t <= steps; t++) {
        vec3  samplePos = p + rayDir * (float(t) * g_voxelSize);
        ivec3 v         = ivec3(floor(samplePos / g_voxelSize));
        vec3  vCenter   = (vec3(v) + vec3(0.5)) * g_voxelSize;

        float voxel2point = depth - dot(vCenter - cam, rayDir);
        if (abs(voxel2point) > trunc) continue;

        float sdf = clamp(voxel2point / trunc, -1.0, 1.0);

        for (int di = 0; di < dirCount; di++) {
            float w = viewFactor * rel[di];
            if (w <= 0.0) continue;
            
            uint key;
            if (!packDirKey(v, dirs[di], key)) continue;

            uint slot = findOrInsert(key);
            if (slot == ~0u) continue;
            atomicAdd(g_hash[slot].sumDW, int(sdf * w * TSDF_SCALE));
            atomicAdd(g_hash[slot].sumW,  uint(w * TSDF_SCALE));
        }
    }
}
